{
  "name": "ningzhi-monitor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build:watch": "turbo build:watch",
    "build": "turbo build",
    "clean": "run-s clean:build clean:caches",
    "clean:all": "run-s clean:build clean:caches clean:deps",
    "clean:build": "pnpm --filter @ningzhi/* clean",
    "clean:caches": "rimraf .turbo/cache **/*/.turbo",
    "clean:deps": "rimraf node_modules **/*/node_modules",
    "dev:server:dsn": "pnpm --filter @ningzhi/monitor-dsn-server start:dev",
    "dev:server:monitor": "pnpm --filter @ningzhi/monitor-server start:dev",
    "dev:client:monitor": "pnpm --filter @ningzhi/monitor-client dev",
    "docker:start": "docker compose -f .devcontainer/docker-compose.yml up -d",
    "docker:stop": "docker compose -f .devcontainer/docker-compose.yml down",
    "lint": "eslint",
    "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --cache --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --cache --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --cache --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --cache --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "prettier": "3.8.4",
    "@eslint/js": "10.0.1",
    "globals": "17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "cspell": "10.0.1",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "commitizen": "4.3.2",
    "cz-git": "1.13.1",
    "lint-staged": "17.0.7",
    "husky": "9.1.7",
    "tsup": "8.5.1",
    "turbo": "2.9.18",
    "rimraf": "6.1.3",
    "npm-run-all2": "9.0.2"
  }
}
