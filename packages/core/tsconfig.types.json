{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0", // 忽略 TypeScript 6.0 及以上版本的警告
    "declaration": true, // 生成 .d.ts 文件
    "declarationMap": true, // 生成 .d.ts.map 文件，便于调试
    "emitDeclarationOnly": true, // 只生成声明文件，不生成 JavaScript 文件
    "rootDir": "./src",
    "outDir": "./build/types" // 输出目录
  }
}
